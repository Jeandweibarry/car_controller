        <Button 
            Canvas.Left="1004" 
            Canvas.Top="328" 
            Height="86" 
            Width="106" 
            RenderTransformOrigin="0.461,0.451" 
            FontSize="40"
            PreviewMouseLeftButtonDown="s2plus_press"
            PreviewMouseLeftButtonUp="s2plus_Released" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top">

            <Button.Template>
