<Window x:Class="rc_controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RC Controller" Height="731" Width="1149">

    <!-- Canvas allows free-form placement -->
    <Canvas Background="#313942">
        <!-- FORWARD button -->
        <Rectangle 
            Height="715" 
            Canvas.Left="779" 
            Stroke="#FF171E21"
            Width="370" 
            Fill="#FF171E21"/>
        <Rectangle 
            Height="336" 
            Stroke="#FF171E21" 
            Width="1149" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center" 
            Canvas.Top="379" 
            Fill="#FF171E21"/>
        <!-- FORWARD button -->
        <Button 
            Width="98"
            Height="94"
            FontSize="22"
            Canvas.Left="302" 
            Canvas.Top="463"
            PreviewMouseLeftButtonDown="ButtonForward_Pressed"
            PreviewMouseLeftButtonUp="ButtonForward_Released" 
            RenderTransformOrigin="0.367,2.341" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20"
                        BorderBrush="Transparent"
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush
                                ImageSource="/Images/Button_Up.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <!-- BACKWARD button -->
        <Button Width="98" 
                Height="94" 
                FontSize="22"
                Canvas.Left="302" 
                Canvas.Top="564"
                PreviewMouseLeftButtonDown="ButtonBackward_Pressed"
                PreviewMouseLeftButtonUp="ButtonBackward_Released" 
                RenderTransformOrigin="1.216,0.486" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
