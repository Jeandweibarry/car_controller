            Canvas.Top="576" 
            Height="82" 
            Width="102" 
            Click="mMinus" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Center">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Motor_Down.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <!-- Increase motor speed button -->
        <Button 
            Canvas.Left="54"
            Canvas.Top="480"
            Height="82"
            Width="102" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Top" 
            Click="mPlus" 
            RenderTransformOrigin="0.461,0.451" 
            FontSize="20">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Motor_Up.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <!-- Information textbox -->
        <TextBox 
            x:Name="DebugTextBox"
            Canvas.Left="54"
            Canvas.Top="400"
            Width="431"
            Height="54"
            TextWrapping="Wrap"
            IsReadOnly="True"
            Text="Waiting for data..." 
            HorizontalAlignment="Center" 
            VerticalAlignment="Top" 
            BorderBrush="#FF00979C"
            BorderThickness="5" FontSize="24" Foreground="White" VerticalContentAlignment="Center">
            <TextBox.Background>
                <ImageBrush/>
            </TextBox.Background>
        </TextBox>

        <!-- Voltage textbox -->
        <TextBox 
            x:Name="VoltageTextBox"
            Canvas.Left="673"
            Canvas.Top="441"
            Width="106"
            Height="33"
            TextWrapping="Wrap"
            IsReadOnly="True"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            TextChanged="VoltageTextBox_TextChanged" FontSize="20" Text="testing" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

        <!-- Temperature textbox -->
        <TextBox  
            x:Name="TemperatureTextBox"
            Canvas.Left="673"
            Canvas.Top="624"
            Width="106"
            Height="32"
            TextWrapping="Wrap"
            IsReadOnly="True"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" FontSize="20" Text="testing" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

        <!-- Humidity textbox -->
        <TextBox  
            x:Name="HumidityTextBox"
            Canvas.Left="673"
            Canvas.Top="560"
            Width="106"
            Height="32"
            TextWrapping="Wrap"
            IsReadOnly="True"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" FontSize="20" Text="testing" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

        <!-- Moisture textbox -->
        <TextBox  
            x:Name="MoistureTextBox"
            Canvas.Left="673"
            Canvas.Top="498"
            Width="106"
            Height="36"
            TextWrapping="Wrap"
            IsReadOnly="True"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" FontSize="20" Text="testing" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <!-- Voltage data update-->
        <Button 
            Content="VOLTAGE" 
            Canvas.Left="543" 
            Canvas.Top="441" 
            Height="33" 
            Width="115" 
            Click="VOLTAGE_BUTTON" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            BorderThickness="0"
            Background="#FF00979C">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10,10,10,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- Humidity data update-->
        <Button 
            Content="HUMIDITY" 
            Canvas.Left="543" 
            Canvas.Top="560" 
            Height="32" 
            Width="115" 
            Click="HUMIDITY_BUTTON" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            BorderThickness="0"
            Background="#FF00979C">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10,10,10,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- Moisture data update-->
        <Button 
            Content="MOISTURE" 
            Canvas.Left="543" 
            Canvas.Top="498" 
            Height="34" 
            Width="115" 
            Click="MOISTURE_BUTTON" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            BorderThickness="0"
            Background="#FF00979C">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10,10,10,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- Temperature data update-->
        <Button 
            Content="TEMPERATURE" 
            Canvas.Left="543" 
            Canvas.Top="624" 
            Height="32" 
            Width="115" 
            Click="TEMPERATURE_BUTTON" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top"
            BorderThickness="0"
            Background="#FF00979C">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10,10,10,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!--servo 1 Increment/Decrement-->
        <Button 
            Canvas.Left="837" 
            Canvas.Top="201" 
            Height="86" 
            Width="106" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            FontSize="40" 
            PreviewMouseLeftButtonDown="s1minus_press"
            PreviewMouseLeftButtonUp="s1minus_Released">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Decrement.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button 
            Canvas.Left="1004" 
            Canvas.Top="201" 
            Height="86" 
            Width="106" 
            RenderTransformOrigin="0.461,0.451" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            FontSize="40"
            PreviewMouseLeftButtonDown="s1plus_press"
            PreviewMouseLeftButtonUp="s1plus_Released" 
            Click="Button_Click">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Increment.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
