            Canvas.Left="837" 
            Canvas.Top="455" 
            Height="86" 
            Width="106" 
            FontSize="40" 
            PreviewMouseLeftButtonDown="s3minus_press"
            PreviewMouseLeftButtonUp="s3minus_Released" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Decrement.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <Button 
            Canvas.Left="1004" 
            Canvas.Top="455" 
            Height="86" 
            Width="106"
            RenderTransformOrigin="0.461,0.451" 
            FontSize="40"
            PreviewMouseLeftButtonDown="s3plus_press"
            PreviewMouseLeftButtonUp="s3plus_Released" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Increment.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <!--servo 4 Increment/Decrement-->

        <Button 
            Canvas.Left="837" 
            Canvas.Top="587" 
            Height="86" 
            Width="106" 
            FontSize="40" 
            PreviewMouseLeftButtonDown="s4minus_press"
            PreviewMouseLeftButtonUp="s4minus_Released" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Decrement.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <Button 
            Canvas.Left="1004" 
            Canvas.Top="587" 
            Height="86" 
            Width="106" 
            RenderTransformOrigin="0.461,0.451" 
            FontSize="40"
            PreviewMouseLeftButtonDown="s4plus_press"
            PreviewMouseLeftButtonUp="s4plus_Released" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Increment.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>
        <Label
            Content="Arm Rotation:"
            Canvas.Left="801"
            Canvas.Top="154"
            Height="34" 
            Width="309" 
            FontSize="22"
            Foreground="White"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"/>
        
        <Label
            Content="Servo A:"
            Canvas.Left="801"
            Canvas.Top="282" 
            Height="36" 
            Width="309" 
            FontSize="22" 
            Foreground="White"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"/>
        
        <Label
            Content="Servo B:"
            Canvas.Left="801"
            Canvas.Top="409"
            Height="45"
            Width="309" 
            FontSize="22"
            Foreground="White"
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"/>
        
        <Label 
            Content="Servo C:" 
            Canvas.Left="801"
            Canvas.Top="541"
            Height="51" 
            Width="309"
            FontSize="22"
            Foreground="White" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"/>
        
        <Image 
            Height="259" 
            Canvas.Left="131"
            Canvas.Top="58"
            Width="527" 
            Source="/arduino_logo.png" 
            Stretch="UniformToFill"
            SnapsToDevicePixels="True" 
            Opacity="0.05"/>
        
        <TextBox 
            x:Name="DebugTextBox_Copy"
            Canvas.Left="801"
            Canvas.Top="58"
            Width="242"
            Height="54"
            TextWrapping="Wrap"
            IsReadOnly="True" 
            BorderBrush="#FF00979C"
            BorderThickness="5" 
            FontSize="24" 
            Foreground="White" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Top" 
            Text="Select COM port" 
            RenderTransformOrigin="0.5,0.5">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                </TransformGroup>
            </TextBox.RenderTransform>
            <TextBox.Background>
                <ImageBrush/>
            </TextBox.Background>
        </TextBox>
        <ComboBox
            Canvas.Left="801"
            Canvas.Top="58"
            Width="242"
            Height="54"
            FontSize="24"
            Text="Select COM port"
            BorderBrush="#FF00979C"
            BorderThickness="5"
            Foreground="White"
            Background="#FF171E21"
            SelectionChanged="ComboBox_SelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Center">

            <!-- Style for dropdown items -->
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF171E21"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#FF00979C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.ItemContainerStyle>

        </ComboBox>
        <Button
            Width="75"
            Height="74"
            Canvas.Left="1058"
            Canvas.Top="48" 
            Click="Button_Click_1" HorizontalAlignment="Left" VerticalAlignment="Center">

            <Button.Template>
                <ControlTemplate 
                    TargetType="{x:Type Button}">

                    <Border 
                        CornerRadius="20" 
                        BorderBrush="Transparent" 
                        BorderThickness="0">

                        <Border.Background>
                            <ImageBrush 
                                ImageSource="/Images/Search.png" 
                                Stretch="UniformToFill"/>
                        </Border.Background>
                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>

