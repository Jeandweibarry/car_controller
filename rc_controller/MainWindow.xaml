                                Stretch="UniformToFill"/>
                        </Border.Background>

                        <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>

                    </Border>
                </ControlTemplate>
            </Button.Template>

        </Button>


